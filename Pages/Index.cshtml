@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row mb-4">
    <div class="col-md-8">
        <h2 class="fw-bold text-primary mb-1">
            <i class="bi bi-speedometer2 me-2"></i>Panel de Control Académico
        </h2>
        <p class="text-secondary">Monitoreo y administración de estudiantes matriculados en Programación III</p>
    </div>
</div>

<!-- Tarjetas de Métricas del Dashboard -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white border-start border-primary border-4">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted text-uppercase fw-semibold small">Total Estudiantes</span>
                        <h3 class="fw-bold text-dark mt-1 mb-0">@Model.TotalEstudiantes</h3>
                    </div>
                    <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white border-start border-success border-4">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted text-uppercase fw-semibold small">Aprobados</span>
                        <h3 class="fw-bold text-success mt-1 mb-0">@Model.EstudiantesAprobados</h3>
                    </div>
                    <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle">
                        <i class="bi bi-check-circle-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white border-start border-danger border-4">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted text-uppercase fw-semibold small">En Riesgo</span>
                        <h3 class="fw-bold text-danger mt-1 mb-0">@Model.EstudiantesReprobados</h3>
                    </div>
                    <div class="bg-danger bg-opacity-10 text-danger p-3 rounded-circle">
                        <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white border-start border-info border-4">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted text-uppercase fw-semibold small">Promedio General</span>
                        <h3 class="fw-bold text-info mt-1 mb-0">@Model.PromedioGeneral</h3>
                    </div>
                    <div class="bg-info bg-opacity-10 text-info p-3 rounded-circle">
                        <i class="bi bi-graph-up-arrow fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tabla de Vista Rápida del Dashboard -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white py-3 border-0">
        <h5 class="fw-bold text-dark mb-0">
            <i class="bi bi-list-check me-2"></i>Estudiantes Registrados Recientemente
        </h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Matrícula</th>
                    <th>Nombre Completo</th>
                    <th>Carrera</th>
                    <th>Calificación</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var est in Model.EstudiantesRecientes)
                {
                    <tr>
                        <td class="fw-semibold">@est.Matricula</td>
                        <td>@est.Nombre</td>
                        <td><span class="badge bg-secondary">@est.Carrera</span></td>
                        <td class="fw-bold">@est.Calificacion</td>
                        <td>
                            @if (est.Calificacion >= 70)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                    <i class="bi bi-check2 me-1"></i>Aprobado
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                    <i class="bi bi-x-circle me-1"></i>Reprobado
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>